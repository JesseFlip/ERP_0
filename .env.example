# Local dev database — matches docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/propertyops?schema=public"

# Session auth — any long random string
AUTH_SECRET="change-me-to-a-random-32-plus-character-string"

# QuickBooks Online (Intuit developer app — https://developer.intuit.com)
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox"
QBO_REDIRECT_URI="http://localhost:3000/api/qbo/oauth/callback"
QBO_WEBHOOK_VERIFIER_TOKEN=""

# At-rest encryption for stored QBO tokens. Falls back to AUTH_SECRET if unset.
TOKEN_ENCRYPTION_KEY=""

# Object storage for photo attachments (S3-compatible: AWS S3, Cloudflare R2, etc.)
# Leave unset in local dev — uploads fall back to public/uploads on disk.
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_BASE_URL=""

# Shared secret the cron trigger must send as `Authorization: Bearer <value>`
CRON_SECRET="change-me"
