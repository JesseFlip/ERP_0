// PropertyOps ERP data model — Phase 1 (Invoice Composer), Phase 2 (Estimating),
// and Phase 3 (job scheduling & crew workflow).
// Every business table is org-scoped from day one (see spec: "Multi-tenancy from day one").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Org {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // QuickBooks Online connection (one company file per org for v1)
  qboRealmId               String?
  qboAccessToken           String? // encrypted at rest via lib/crypto
  qboRefreshToken          String? // encrypted at rest via lib/crypto
  qboAccessTokenExpiresAt  DateTime?
  qboRefreshTokenExpiresAt DateTime?
  qboConnectedAt           DateTime?
  qboDisconnectedAt        DateTime?

  users        User[]
  customers    Customer[]
  catalogItems CatalogItem[]
  jobs         Job[]
  invoices     Invoice[]
  syncJobs     SyncJob[]
  crews        Crew[]
  estimates    Estimate[]

  @@map("orgs")
}

enum UserRole {
  OWNER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Customers (mirrored from QBO, created there when new)
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(cuid())
  orgId         String
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  qboCustomerId String?
  name          String
  email         String?
  phone         String?
  billingLine1  String?
  billingCity   String?
  billingState  String?
  billingZip    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobs      Job[]
  invoices  Invoice[]
  estimates Estimate[]

  @@unique([orgId, qboCustomerId])
  @@index([orgId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Catalog / price list — shared service now so Phase 2 estimating can reuse it
// ---------------------------------------------------------------------------

enum CatalogItemKind {
  SERVICE
  MATERIAL
}

model CatalogItem {
  id          String          @id @default(cuid())
  orgId       String
  org         Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  qboItemId   String?
  name        String
  description String?
  kind        CatalogItemKind @default(SERVICE)
  unit        String          @default("ea")
  defaultRate Decimal         @db.Decimal(12, 2)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  invoiceLines  InvoiceLine[]
  estimateLines EstimateLine[]
  jobLines      JobLine[]

  @@unique([orgId, qboItemId])
  @@index([orgId])
  @@map("catalog_items")
}

// ---------------------------------------------------------------------------
// Jobs — v1 shipped as deliberately minimal ("name, customer, done-date,
// notes"); Phase 3 extends it with scheduling, crew assignment, and a working
// line-item list that carries planned work (from an estimate) and field
// change-orders through to invoicing, without changing the v1 shape.
// ---------------------------------------------------------------------------

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  DONE_NOT_INVOICED
  INVOICED
  DISMISSED
}

model Job {
  id              String    @id @default(cuid())
  orgId           String
  org             Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  name            String
  notes           String?
  status          JobStatus @default(DONE_NOT_INVOICED)
  dismissedReason String?
  invoiceId       String?   @unique
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Set when the job is logged as finished (manual entry) or when field
  // completion is marked from the work order (scheduled → in-progress flow).
  doneDate DateTime?

  // Scheduling (Phase 3) — all optional so the v1 manual "log a finished job"
  // flow keeps working without ever touching these.
  scheduledDate   DateTime?
  scheduledWindow String?
  crewId          String?
  crew            Crew?     @relation(fields: [crewId], references: [id])

  // Set when this job originated from an accepted estimate (Phase 2).
  estimateId String?   @unique
  estimate   Estimate? @relation(fields: [estimateId], references: [id])

  attachments Attachment[]
  lines       JobLine[]

  @@index([orgId, status])
  @@index([orgId, scheduledDate])
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// Job line items — the working list of planned work (copied from an accepted
// estimate) and field change-orders. This is what the invoice composer seeds
// from when composing an invoice off a job, so an extra billed on-site never
// has to be re-typed or gets forgotten between the field and the invoice.
// ---------------------------------------------------------------------------

enum JobLineType {
  PLANNED
  CHANGE_ORDER
}

model JobLine {
  id            String       @id @default(cuid())
  jobId         String
  job           Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])
  description   String
  quantity      Decimal      @default(1) @db.Decimal(12, 2)
  rate          Decimal      @db.Decimal(12, 2)
  amount        Decimal      @db.Decimal(12, 2)
  lineType      JobLineType  @default(PLANNED)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([jobId])
  @@map("job_lines")
}

// ---------------------------------------------------------------------------
// Crews (Phase 3) — lightweight named teams for scheduling and work orders.
// Not a login: crew members aren't app users in v1, matching the spec's
// white-glove, owner-operated auth model. The owner (or whoever's holding the
// phone at the truck) schedules, prints/opens the work order, and marks jobs
// complete.
// ---------------------------------------------------------------------------

model Crew {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  colorHex  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([orgId])
  @@map("crews")
}

// ---------------------------------------------------------------------------
// Estimates (Phase 2) — replaces the spreadsheet estimating tool. Shares the
// same catalog as invoicing (see CatalogItem). An accepted estimate converts
// to a Job, carrying its lines over as JobLine(PLANNED) so scheduling and the
// eventual invoice both start from what was actually quoted.
// ---------------------------------------------------------------------------

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Estimate {
  id          String         @id @default(cuid())
  orgId       String
  org         Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id])
  status      EstimateStatus @default(DRAFT)
  subtotal    Decimal        @default(0) @db.Decimal(12, 2)
  total       Decimal        @default(0) @db.Decimal(12, 2)
  memo        String?
  validUntil  DateTime?
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lines EstimateLine[]
  job   Job?

  @@index([orgId, status])
  @@map("estimates")
}

model EstimateLine {
  id            String       @id @default(cuid())
  estimateId    String
  estimate      Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])
  description   String
  quantity      Decimal      @default(1) @db.Decimal(12, 2)
  rate          Decimal      @db.Decimal(12, 2)
  amount        Decimal      @db.Decimal(12, 2)
  sortOrder     Int          @default(0)

  @@index([estimateId])
  @@map("estimate_lines")
}

// ---------------------------------------------------------------------------
// Invoices
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT // being composed locally, not yet finalized
  NOT_POSTED // finalized locally, QBO push pending or failed
  POSTED // created in QBO, no customer-visible status yet
  SENT
  VIEWED
  PAID
}

model Invoice {
  id             String        @id @default(cuid())
  orgId          String
  org            Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  qboInvoiceId   String?
  qboSyncToken   String?
  idempotencyKey String        @unique @default(cuid())
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  memo           String?
  finalizedAt    DateTime?
  lastSyncedAt   DateTime?
  lastSyncError  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines       InvoiceLine[]
  attachments Attachment[]
  syncJobs    SyncJob[]
  job         Job?

  @@unique([orgId, qboInvoiceId])
  @@index([orgId, status])
  @@map("invoices")
}

enum InvoiceLineType {
  STANDARD
  CHANGE_ORDER
}

model InvoiceLine {
  id            String          @id @default(cuid())
  invoiceId     String
  invoice       Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  catalogItemId String?
  catalogItem   CatalogItem?    @relation(fields: [catalogItemId], references: [id])
  description   String
  quantity      Decimal         @default(1) @db.Decimal(12, 2)
  rate          Decimal         @db.Decimal(12, 2)
  amount        Decimal         @db.Decimal(12, 2)
  lineType      InvoiceLineType @default(STANDARD)
  notes         String?
  sortOrder     Int             @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ---------------------------------------------------------------------------
// Attachments (before/after photos, job notes evidence)
// ---------------------------------------------------------------------------

model Attachment {
  id        String   @id @default(cuid())
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([invoiceId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// QBO sync retry queue — background-job-backed so pushes are never silent
// ---------------------------------------------------------------------------

enum SyncJobStatus {
  PENDING
  RUNNING
  FAILED
  SUCCEEDED
}

model SyncJob {
  id            String        @id @default(cuid())
  orgId         String
  org           Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  status        SyncJobStatus @default(PENDING)
  attempts      Int           @default(0)
  lastError     String?
  nextAttemptAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, nextAttemptAt])
  @@index([orgId])
  @@map("sync_jobs")
}
